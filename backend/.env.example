# Leave MONGO_URL empty to use the built-in local demo data store.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=your-email@example.com
SALT=10
FRONTEND_URL=http://127.0.0.1:5173
UPLOADS_DIR=uploads

# Optional: add a Stripe test secret to use Stripe Checkout instead of demo checkout.
# STRIPE_SECRET_KEY=sk_test_your_key

# Optional: set this to use MongoDB instead of the local demo data store.
# MONGO_URL=mongodb://127.0.0.1:27017/amber
